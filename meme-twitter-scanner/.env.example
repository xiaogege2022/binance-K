# Twitter burner account credentials
TWITTER_USERNAME=your_twitter_username
TWITTER_PASSWORD=your_twitter_password
TWITTER_EMAIL=your_twitter_email

# Server port
PORT=3000

# Twitter check interval in milliseconds (default: 1000ms = 1 second)
TWITTER_CHECK_INTERVAL=1000

# Max tweets to fetch per user (default: 5)
MAX_TWEETS_PER_USER=5

# Cache TTL in minutes - skip re-checking same twitter within this window
CACHE_TTL_MINUTES=30

# OKX page refresh interval in milliseconds (how often to re-scan the page)
OKX_SCAN_INTERVAL=5000

# Chains to monitor: sol,bsc (comma separated)
MONITOR_CHAINS=sol,bsc
